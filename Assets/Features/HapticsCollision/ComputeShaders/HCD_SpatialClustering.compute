#pragma kernel ClearClusters
#pragma kernel AccumulateClusters
#pragma kernel ClearCovariance
#pragma kernel AccumulateCovariance

struct PointCollisionData
{
    int isColliding;     // 0: None, 1: Surface, 2: Inside
    float distance;      // 最短距離 (m)
    float3 pointPos;     // 点群実測座標
    float3 hitPoint;     // メッシュ表面の投影点
    float3 hitNormal;    // メッシュ表面法線
};

// ClusterData layout (stride = 60 bytes = 15 ints)
struct ClusterData
{
    int count;
    int weightSum;  // fixed point x10000
    int posX;       // fixed point x10000 (primary active position)
    int posY;
    int posZ;
    int normalX;    // fixed point x10000
    int normalY;
    int normalZ;
    int rawPosX;    // fixed point x10000 (raw point cloud position)
    int rawPosY;
    int rawPosZ;
    int meshPosX;   // fixed point x10000 (mesh surface hit position)
    int meshPosY;
    int meshPosZ;
    int minDistInt; // fixed point x1000000 for min distance
};

// Covariance & Random Data (stride = 12 ints = 48 bytes)
struct ClusterPrecisionData
{
    int covXX;
    int covYY;
    int covZZ;
    int covXY;
    int covXZ;
    int covYZ;
    
    // Random sample points (fixed-point x10000)
    int3 rp[16];
};

StructuredBuffer<PointCollisionData> CollisionBuffer;
RWStructuredBuffer<ClusterData> ClusterBuffer;
RWStructuredBuffer<ClusterPrecisionData> PrecisionBuffer;

uint PointsCount;
float CellSize;
uint MaxClusters;
uint RandomSeed;

uint AggregationMode;         // 0: UnweightedCentroid, 1: DistanceWeightedCentroid, 2: NearestPoint
uint PositionSource;          // 0: MeshSurface, 1: PointCloudRaw
float SurfaceDistanceThreshold;
float DistanceWeightPower;

// ── Normal bin quantization ────────────────────────────────────────────────
uint GetNormalBin(float3 n)
{
    float ax = abs(n.x);
    float ay = abs(n.y);
    float az = abs(n.z);
    if (ax >= ay && ax >= az) return n.x >= 0.0 ? 0u : 1u;
    if (ay >= ax && ay >= az) return n.y >= 0.0 ? 2u : 3u;
    return n.z >= 0.0 ? 4u : 5u;
}

// ── Spatial hash (position + normal bin) ──────────────────────────────────
uint Hash(int3 gridPos, uint normalBin)
{
    uint h = (uint)(gridPos.x * 73856093 ^ gridPos.y * 19349663 ^ gridPos.z * 83492791)
             ^ (normalBin * 2654435761u);
    return h % MaxClusters;
}

// Pseudo-random function
uint Rand(uint seed, uint id)
{
    uint h = seed + id * 374761393u;
    h = (h ^ (h >> 13)) * 3266489917u;
    return h ^ (h >> 16);
}

[numthreads(256, 1, 1)]
void ClearClusters(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= MaxClusters) return;

    ClusterBuffer[id.x].count      = 0;
    ClusterBuffer[id.x].weightSum  = 0;
    ClusterBuffer[id.x].posX       = 0;
    ClusterBuffer[id.x].posY       = 0;
    ClusterBuffer[id.x].posZ       = 0;
    ClusterBuffer[id.x].normalX    = 0;
    ClusterBuffer[id.x].normalY    = 0;
    ClusterBuffer[id.x].normalZ    = 0;
    ClusterBuffer[id.x].rawPosX    = 0;
    ClusterBuffer[id.x].rawPosY    = 0;
    ClusterBuffer[id.x].rawPosZ    = 0;
    ClusterBuffer[id.x].meshPosX   = 0;
    ClusterBuffer[id.x].meshPosY   = 0;
    ClusterBuffer[id.x].meshPosZ   = 0;
    ClusterBuffer[id.x].minDistInt = 2147483647; // 0x7FFFFFFF
}

[numthreads(256, 1, 1)]
void AccumulateClusters(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= PointsCount) return;

    PointCollisionData col = CollisionBuffer[id.x];
    if (col.isColliding != 1 && col.isColliding != 2) return; // Surface または Inside の接触点のみ集計

    int3 gridPos = (int3)floor(col.hitPoint / CellSize);
    uint normalBin = GetNormalBin(col.hitNormal);
    uint hashIndex = Hash(gridPos, normalBin);

    // Selected primary target position
    float3 primaryPos = (PositionSource == 1) ? col.pointPos : col.hitPoint;

    // Compute weight
    float weight = 1.0;
    if (AggregationMode == 1) // DistanceWeightedCentroid
    {
        float maxThresh = max(0.0001, SurfaceDistanceThreshold);
        float normDist = saturate(col.distance / maxThresh);
        float rawWeight = pow(saturate(1.0 - normDist), max(1.0, DistanceWeightPower));
        weight = clamp(rawWeight, 0.05, 1.0); // 桁数(100,000)に応じた下限(0.05)・上限(1.0)クランプ
    }
    else if (AggregationMode == 2) // NearestPoint (sharp power weighting)
    {
        float maxThresh = max(0.0001, SurfaceDistanceThreshold);
        float normDist = saturate(col.distance / maxThresh);
        float rawWeight = pow(saturate(1.0 - normDist), 4.0);
        weight = clamp(rawWeight, 0.05, 1.0); // 桁数(100,000)に応じた下限(0.05)・上限(1.0)クランプ
    }

    int wInt = (int)(weight * 100000.0);

    int fx  = (int)(primaryPos.x   * weight * 100000.0);
    int fy  = (int)(primaryPos.y   * weight * 100000.0);
    int fz  = (int)(primaryPos.z   * weight * 100000.0);

    int rfx = (int)(col.pointPos.x * weight * 100000.0);
    int rfy = (int)(col.pointPos.y * weight * 100000.0);
    int rfz = (int)(col.pointPos.z * weight * 100000.0);

    int mfx = (int)(col.hitPoint.x * weight * 100000.0);
    int mfy = (int)(col.hitPoint.y * weight * 100000.0);
    int mfz = (int)(col.hitPoint.z * weight * 100000.0);

    int nx  = (int)(col.hitNormal.x * weight * 100000.0);
    int ny  = (int)(col.hitNormal.y * weight * 100000.0);
    int nz  = (int)(col.hitNormal.z * weight * 100000.0);

    int dInt = (int)(col.distance * 1000000.0);

    InterlockedAdd(ClusterBuffer[hashIndex].count,     1);
    InterlockedAdd(ClusterBuffer[hashIndex].weightSum, wInt);

    InterlockedAdd(ClusterBuffer[hashIndex].posX,    fx);
    InterlockedAdd(ClusterBuffer[hashIndex].posY,    fy);
    InterlockedAdd(ClusterBuffer[hashIndex].posZ,    fz);

    InterlockedAdd(ClusterBuffer[hashIndex].normalX, nx);
    InterlockedAdd(ClusterBuffer[hashIndex].normalY, ny);
    InterlockedAdd(ClusterBuffer[hashIndex].normalZ, nz);

    InterlockedAdd(ClusterBuffer[hashIndex].rawPosX, rfx);
    InterlockedAdd(ClusterBuffer[hashIndex].rawPosY, rfy);
    InterlockedAdd(ClusterBuffer[hashIndex].rawPosZ, rfz);

    InterlockedAdd(ClusterBuffer[hashIndex].meshPosX, mfx);
    InterlockedAdd(ClusterBuffer[hashIndex].meshPosY, mfy);
    InterlockedAdd(ClusterBuffer[hashIndex].meshPosZ, mfz);

    InterlockedMin(ClusterBuffer[hashIndex].minDistInt, dInt);
}

[numthreads(256, 1, 1)]
void ClearCovariance(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= MaxClusters) return;
    PrecisionBuffer[id.x].covXX = 0;
    PrecisionBuffer[id.x].covYY = 0;
    PrecisionBuffer[id.x].covZZ = 0;
    PrecisionBuffer[id.x].covXY = 0;
    PrecisionBuffer[id.x].covXZ = 0;
    PrecisionBuffer[id.x].covYZ = 0;
    for (int i = 0; i < 16; i++) {
        PrecisionBuffer[id.x].rp[i] = int3(0, 0, 0);
    }
}

[numthreads(256, 1, 1)]
void AccumulateCovariance(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= PointsCount) return;

    PointCollisionData col = CollisionBuffer[id.x];
    if (col.isColliding != 1 && col.isColliding != 2) return;

    int3 gridPos = (int3)floor(col.hitPoint / CellSize);
    uint normalBin = GetNormalBin(col.hitNormal);
    uint hashIndex = Hash(gridPos, normalBin);

    int count = ClusterBuffer[hashIndex].count;
    if (count <= 1) return; // Needs at least 2 points for variance

    int weightSum = ClusterBuffer[hashIndex].weightSum;
    float invW = (weightSum > 0) ? (1.0 / (float)weightSum) : (1.0 / (count * 10000.0));
    float3 clusterCentroid = float3(ClusterBuffer[hashIndex].posX, ClusterBuffer[hashIndex].posY, ClusterBuffer[hashIndex].posZ) * invW;
    
    float3 targetPos = (PositionSource == 1) ? col.pointPos : col.hitPoint;
    float3 d = targetPos - clusterCentroid;

    // Scale by 1,000,000 for precision. Max dev ~0.05m -> sq = 0.0025. 0.0025 * 1e6 = 2500
    int cXX = (int)(d.x * d.x * 1000000.0);
    int cYY = (int)(d.y * d.y * 1000000.0);
    int cZZ = (int)(d.z * d.z * 1000000.0);
    int cXY = (int)(d.x * d.y * 1000000.0);
    int cXZ = (int)(d.x * d.z * 1000000.0);
    int cYZ = (int)(d.y * d.z * 1000000.0);

    InterlockedAdd(PrecisionBuffer[hashIndex].covXX, cXX);
    InterlockedAdd(PrecisionBuffer[hashIndex].covYY, cYY);
    InterlockedAdd(PrecisionBuffer[hashIndex].covZZ, cZZ);
    InterlockedAdd(PrecisionBuffer[hashIndex].covXY, cXY);
    InterlockedAdd(PrecisionBuffer[hashIndex].covXZ, cXZ);
    InterlockedAdd(PrecisionBuffer[hashIndex].covYZ, cYZ);

    // Pseudo-randomly update sample points
    uint rnd = Rand(RandomSeed, id.x);
    if ((rnd % count) == 0) 
    {
        int px = (int)(targetPos.x * 10000.0);
        int py = (int)(targetPos.y * 10000.0);
        int pz = (int)(targetPos.z * 10000.0);
        
        uint slot = rnd & 15;
        
        InterlockedExchange(PrecisionBuffer[hashIndex].rp[slot].x, px, px);
        InterlockedExchange(PrecisionBuffer[hashIndex].rp[slot].y, py, py);
        InterlockedExchange(PrecisionBuffer[hashIndex].rp[slot].z, pz, pz);
    }
}

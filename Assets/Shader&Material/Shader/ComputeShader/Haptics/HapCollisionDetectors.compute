#pragma kernel CheckCollision
#pragma kernel CheckCollisionMesh

#define NUM_SECTORS 8

// Defined same as STRIDE in RsGlobalPointCloudManager
struct PointData
{
    float3 pos;
    float3 col;
    uint type;
};

// 拡張: アタリ判定の結果と、命中位置・法線を格納する構造体
struct HitResult
{
    int isColliding;
    float3 hitPoint;
    float3 hitNormal;
};

StructuredBuffer<PointData> PointCloudBuffer;
RWStructuredBuffer<HitResult> Result;

int PointsCount;
float3 TargetPosition;
float Radius;
float RadiusSqr;
float3 SphereCenterWorld; // 球の中心（オクタント計算用）

// For SkinnedMeshRenderer / MeshFilter mode
StructuredBuffer<float3> MeshVerticesBuffer;
StructuredBuffer<float3> MeshNormalsBuffer;
float4x4 LocalToWorldMatrix;
int MeshVerticesCount;
float3 MeshBoundsMin;
float3 MeshBoundsMax;
int VertexSubstep;

// 方向ベクトルから 0〜7 のオクタントインデックスを返す
int GetOctant(float3 dir)
{
    return (dir.x >= 0 ? 0 : 4) | (dir.y >= 0 ? 0 : 2) | (dir.z >= 0 ? 0 : 1);
}

[numthreads(256, 1, 1)]
void CheckCollision(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint) PointsCount)
        return;

    float3 pointPos = PointCloudBuffer[id.x].pos;
    float3 diff = pointPos - TargetPosition;

    if (dot(diff, diff) <= RadiusSqr)
    {
        int sector = GetOctant(diff);
        int originalValue;
        InterlockedCompareExchange(Result[sector].isColliding, 0, 1, originalValue);

        if (originalValue == 0)
        {
            Result[sector].hitPoint = pointPos;
            Result[sector].hitNormal = normalize(diff);
        }
    }
}

[numthreads(256, 1, 1)]
void CheckCollisionMesh(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint) PointsCount)
        return;

    float3 pointPos = PointCloudBuffer[id.x].pos;

    // 1. Broad-phase AABB Culling
    if (pointPos.x < MeshBoundsMin.x || pointPos.x > MeshBoundsMax.x ||
        pointPos.y < MeshBoundsMin.y || pointPos.y > MeshBoundsMax.y ||
        pointPos.z < MeshBoundsMin.z || pointPos.z > MeshBoundsMax.z)
    {
        return;
    }

    // 2. Narrow-phase Sampling
    for (int i = 0; i < MeshVerticesCount; i += VertexSubstep)
    {
        float3 localVert = MeshVerticesBuffer[i];
        float3 worldVert = mul(LocalToWorldMatrix, float4(localVert, 1.0)).xyz;

        float3 diff = pointPos - worldVert;
        if (dot(diff, diff) <= RadiusSqr)
        {
            // 球の中心から頂点への方向でオクタントを決定
            float3 vertDir = worldVert - SphereCenterWorld;
            int sector = GetOctant(vertDir);

            int originalValue;
            InterlockedCompareExchange(Result[sector].isColliding, 0, 1, originalValue);

            if (originalValue == 0)
            {
                float3 localNorm = MeshNormalsBuffer[i];
                float3 worldNorm = mul((float3x3) LocalToWorldMatrix, localNorm);
                Result[sector].hitPoint = worldVert;
                Result[sector].hitNormal = normalize(worldNorm);
            }
            return;
        }
    }
}
